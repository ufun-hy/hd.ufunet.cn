{
  "name": "workerman/webman",
  "type": "project",
  "keywords": [
    "high performance",
    "http service"
  ],
  "homepage": "https://www.workerman.net",
  "license": "MIT",
  "description": "High performance HTTP Service Framework.",
  "authors": [
    {
      "name": "walkor",
      "email": "walkor@workerman.net",
      "homepage": "https://www.workerman.net",
      "role": "Developer"
    }
  ],
  "support": {
    "email": "walkor@workerman.net",
    "issues": "https://github.com/walkor/webman/issues",
    "forum": "https://wenda.workerman.net/",
    "wiki": "https://workerman.net/doc/webman",
    "source": "https://github.com/walkor/webman"
  },
  "require": {
    "php": ">=7.2",
    "workerman/webman-framework": "^1.5.0",
    "monolog/monolog": "^2.0",
    "topthink/think-template": "^2.0",
    "illuminate/redis": "^8.83",
    "illuminate/events": "^8.83",
    "webman/think-orm": "^1.1",
    "phpoffice/phpspreadsheet": "^1.25",
    "webman/gateway-worker": "^1.0",
    "webman/captcha": "^1.0",
    "endroid/qr-code": "4.3.5",
    "pclzip/pclzip": "2.8.2",
    "yansongda/pay": "^2.10",
    "geoip2/geoip2": "v2.13.0",
    "aliyuncs/oss-sdk-php": "v2.4.2",
    "alibabacloud/green": "1.8.958",
    "alibabacloud/client": "^1.5.32",
    "alibabacloud/facebody-20191230": "3.0.9",
    "qiniu/php-sdk": "^7.14",
    "tencentcloud/tencentcloud-sdk-php": "3.0.547",
    "qcloud/cos-sdk-v5": "^2.5",
    "qcloud_sts/qcloud-sts-sdk": "3.0.6",
    "topthink/think-validate": "^2.0",
    "webman/redis-queue": "^1.3",
    "overtrue/wechat": "~5.36",
    "webman/event": "^1.0",
    "kkokk/poster": "v2.3.2",
    "workerman/crontab": "^1.0",
    "intervention/image": "^2.7",
    "workerman/http-client": "v1.0.11",
    "topthink/think-orm": "2.0.62",
    "chinayin/ip2region": "^2.0",
    "webman/rate-limiter": "^1.1",
    "guzzlehttp/guzzle": "^7.15",
    "guzzlehttp/psr7": "^2.12.3",
    "guzzlehttp/guzzle-services": "^1.5.4",
    "alibabacloud/tea-oss-utils": "^0.3.2"
  },
  "suggest": {
    "ext-event": "For better performance. "
  },
  "autoload": {
    "psr-4": {
      "": "./",
      "app\\": "./app",
      "App\\": "./app",
      "app\\View\\Components\\": "./app/view/components"
    },
    "files": [
      "./support/helpers.php"
    ]
  },
  "scripts": {
    "post-package-install": [
      "support\\Plugin::install"
    ],
    "post-package-update": [
      "support\\Plugin::install"
    ],
    "pre-package-uninstall": [
      "support\\Plugin::uninstall"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "easywechat-composer/easywechat-composer": true
    }
  },
  "repositories": [{
    "name": "packagist",
    "type": "composer",
    "url": "https://mirrors.cloud.tencent.com/composer/"
  }]
}
